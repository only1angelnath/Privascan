# PrivaScan — Environment Variables Reference
# Copy to .env and fill in your values. Never commit .env to git.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_API_KEY=your-admin-key-here

# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/privascan
# Production Railway (use internal URL on Railway, public URL for local access)
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@roundhouse.proxy.rlwy.net:54414/railway

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://default:PASSWORD@redis.railway.internal:6379/0

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# CELERY_BROKER_URL=redis://default:PASSWORD@redis.railway.internal:6379/0
# CELERY_RESULT_BACKEND=redis://default:PASSWORD@redis.railway.internal:6379/1

# ── Blockchain APIs ───────────────────────────────────────────────────────────
ETHERSCAN_API_KEY=your-etherscan-key
ALCHEMY_API_KEY=your-alchemy-key
DUNE_API_KEY=your-dune-key

# ── DeFi Data ─────────────────────────────────────────────────────────────────
COINGECKO_API_KEY=your-coingecko-key

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token

# ── GitHub (optional — avoids 60 req/hr limit on exploit DB refresh) ──────────
# Generate at: github.com/settings/tokens (read:public_repo scope)
GITHUB_TOKEN=ghp_your_token_here

# ── Demo API key ──────────────────────────────────────────────────────────────
DEMO_API_KEY=ps_privascan_shared_demo_key_v1_2026_public

# ── Rate limits ───────────────────────────────────────────────────────────────
RATE_LIMIT_ANONYMOUS=10
RATE_LIMIT_FREE=500
RATE_LIMIT_PRO=2000
RATE_LIMIT_ANONYMOUS_PER_MIN=2
RATE_LIMIT_FREE_PER_MIN=15
RATE_LIMIT_PRO_PER_MIN=60
